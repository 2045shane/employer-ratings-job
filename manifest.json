{
  "manifest_version": 3,
  "name": "招聘页查询签证担保",
  "version": "0.2.0",
  "description": "在 LinkedIn 职位页查询雇主是否出现在英国官方 Skilled Worker 担保名册。不是雇主评分。",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.linkedin.com/jobs/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/options/options.html",
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*"
      ],
      "js": [
        "src/lib/company.js",
        "src/lib/sponsors.js",
        "src/content/selectors.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
